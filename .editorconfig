# PlayNext — consistent formatting across the repository.
# Enforced as a code-quality standard in .specify/memory/constitution.md.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,js,mjs,cjs,json,jsonc,html,css,scss,yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,csproj,sln,props,targets}]
indent_size = 4

[*.{ps1,psm1,psd1}]
indent_size = 4

[*.{sh,bash}]
indent_size = 2
