{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Tmdb": {
    "ServiceTitlesPerGenre": 300,
    "MaxDiscoverPages": 25,
    "MaxRetries": 2,
    "RequestsPerSecond": 30,
    "Language": "en-US"
  },
  "Catalog": {
    "Source": "Snapshot",
    "MaxPoolTitles": 1000,
    "MaxIdsPerRequest": 1000,
    "RefreshTimeoutMinutes": 55,
    "RefreshConcurrency": 4,
    "Migration": {
      "Enabled": false
    }
  }
}
