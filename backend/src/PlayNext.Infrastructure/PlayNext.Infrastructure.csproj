<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    The ASP.NET Core shared framework, for Identity's UserManager / IPasswordHasher
    and the authentication handlers. This layer is where framework-specific
    persistence and identity live; the Domain and Application layers stay free of
    it (constitution VII — dependencies point inward, and the inner two rings do
    not reference ASP.NET Core at all).
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    Pinned to the 10.0.x line to match the target framework: these ASP.NET Core
    and EF Core packages ship in lockstep with the runtime. Versions are pinned
    rather than floated so a restore cannot silently change the build.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlayNext.Application\PlayNext.Application.csproj" />
  </ItemGroup>

</Project>
